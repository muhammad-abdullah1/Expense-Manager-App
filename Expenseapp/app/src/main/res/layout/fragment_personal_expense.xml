<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/totalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_hero_bg_square"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL SPENT"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="#DCD1FF" />

            <TextView
                android:id="@+id/personalTotalCostTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Across all your personal expenses"
                android:textSize="12sp"
                android:textColor="#DCD1FF"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/recentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/totalCard"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:text="Recent expenses"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary_on_dark" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/personalExpenseRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/recentLabel"
        android:layout_above="@+id/spacerBottom"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        android:background="@android:color/transparent" />

    <View
        android:id="@+id/spacerBottom"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addPersonalExpenseFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:text="Add expense"
        android:textColor="@color/white"
        android:textAllCaps="false"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="@color/brand_primary"
        app:elevation="6dp" />

</RelativeLayout>