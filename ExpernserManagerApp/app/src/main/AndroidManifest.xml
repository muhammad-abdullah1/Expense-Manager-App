<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/spending"
        android:label="@string/app_name"
        android:roundIcon="@drawable/spending"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chequepoint"
        tools:targetApi="31">

        <!-- Firebase initialization -->

        <meta-data
            android:name="firebase_database_url"
            android:value="@string/firebase_database_url" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- MainActivity (Login) -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.ChequePoint"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signup Activity -->
        <activity
            android:name=".Signup"
            android:theme="@style/Theme.ChequePoint"
            android:exported="false" />

        <!-- Expense Activity (screen1) -->
        <activity
            android:name=".screen1"
            android:theme="@style/Theme.ChequePoint"
            android:exported="false" />
    </application>
</manifest>